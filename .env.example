# Required
IIKO_URL=https://your-restaurant.iiko.it:443
IIKO_LOGIN=your-login
IIKO_PASS=your-password

# Optional: map cash register numbers to venue names
# Example: "Cafe A=4,Cafe B=5"
IIKO_VENUE_MAP=

# Optional: verify SSL (default false — iiko often uses self-signed certs)
IIKO_VERIFY_SSL=false
